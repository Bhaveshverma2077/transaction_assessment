{
  "info": {
    "_postman_id": "7b8e1f20-94e8-4ec8-bb8e-a2ec4c8b2a19",
    "name": "Transaction Ledger API",
    "description": "Production-grade Postman collection for Transaction Ledger API. Includes Account management, Credit/Debit Ledger transactions, Balance Verification, Money Transfers, and Immutability enforcement tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "destinationAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Checks API uptime and MongoDB connection topology (Standalone or Replica Set)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Accounts",
      "item": [
        {
          "name": "Create Primary Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('accountId', res.data.id);",
                  "    console.log('Saved accountId:', res.data.id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Initial balance is 0', () => {",
                  "    pm.expect(res.data.balance).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Creates a new ledger account. Balance automatically initializes to 0.00."
          },
          "response": []
        },
        {
          "name": "Create Secondary Account (For Transfers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('destinationAccountId', res.data.id);",
                  "    console.log('Saved destinationAccountId:', res.data.id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Jones\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Creates a second account to test transfers."
          },
          "response": []
        },
        {
          "name": "Get Account By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}"]
            },
            "description": "Retrieves account metadata and current balance."
          },
          "response": []
        },
        {
          "name": "Get Account Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "balance"]
            },
            "description": "Returns current balance for the given account."
          },
          "response": []
        },
        {
          "name": "Audit & Verify Account Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/verify-balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "verify-balance"]
            },
            "description": "Audits ledger integrity by summing credits and subtracting debits from all transactions and verifying it matches cached account balance."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Transactions",
      "item": [
        {
          "name": "Credit Account (Deposit 100.00)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('creditRefId', 'ref-credit-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('transactionId', res.data.id);",
                  "}",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Transaction type is credit', () => {",
                  "    pm.expect(res.data.type).to.eql('credit');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 100.00,\n  \"description\": \"Initial account deposit\",\n  \"reference_id\": \"{{creditRefId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Applies a credit transaction to the specified account. Automatically generates a fresh reference_id if not overridden."
          },
          "response": []
        },
        {
          "name": "Debit Account (Withdraw 30.00)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('debitRefId', 'ref-debit-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Transaction type is debit', () => {",
                  "    pm.expect(res.data.type).to.eql('debit');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 30.00,\n  \"description\": \"Coffee and groceries purchase\",\n  \"reference_id\": \"{{debitRefId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Applies a debit transaction to the account if sufficient funds exist."
          },
          "response": []
        },
        {
          "name": "Direct Transaction Creation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('directRefId', 'ref-direct-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"type\": \"credit\",\n  \"amount\": 50.00,\n  \"description\": \"Direct ledger credit\",\n  \"reference_id\": \"{{directRefId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            },
            "description": "Creates a transaction via top-level endpoint with account_id in the JSON body."
          },
          "response": []
        },
        {
          "name": "Get Transaction History (All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Fetches paginated list of transactions sorted latest-first."
          },
          "response": []
        },
        {
          "name": "Filter Transactions by Type (Credit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions?type=credit&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"],
              "query": [
                {
                  "key": "type",
                  "value": "credit"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Filters transactions by type ('credit' or 'debit')."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Money Transfers (Bonus)",
      "item": [
        {
          "name": "Transfer Funds Between Accounts",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('transferRefId', 'transfer-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountId}}\",\n  \"to_account_id\": \"{{destinationAccountId}}\",\n  \"amount\": 25.00,\n  \"description\": \"Project expense split\",\n  \"reference_id\": \"{{transferRefId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers"]
            },
            "description": "Atomically transfers funds from one account to another, creating linked debit and credit transactions."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Immutability & Validation Tests",
      "item": [
        {
          "name": "Immutability: Reject PUT Transaction (405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 405 Method Not Allowed', () => {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions", "{{transactionId}}"]
            },
            "description": "Verifies that modifying a transaction via PUT is rejected with 405 Method Not Allowed."
          },
          "response": []
        },
        {
          "name": "Immutability: Reject DELETE Transaction (405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 405 Method Not Allowed', () => {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions", "{{transactionId}}"]
            },
            "description": "Verifies that deleting a transaction via DELETE is rejected with 405 Method Not Allowed."
          },
          "response": []
        },
        {
          "name": "Idempotency: Reject Duplicate reference_id (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', () => {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 50.00,\n  \"description\": \"Duplicate reference test\",\n  \"reference_id\": \"duplicate-test-ref-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Sending this request twice with the same reference_id ensures the second request is rejected with 409 Conflict."
          },
          "response": []
        },
        {
          "name": "Validation: Reject Overdrawing Debit (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', () => {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 999999.00,\n  \"description\": \"Overdraw attempt\",\n  \"reference_id\": \"overdraw-test-ref\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Verifies that an account cannot be overdrawn, returning 422 Unprocessable Entity."
          },
          "response": []
        }
      ]
    }
  ]
}
